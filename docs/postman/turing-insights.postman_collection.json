              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Devuelve id del mensaje', function () {",
                  "    pm.expect(res.data.id).to.be.a('number');",
