      "item": [
        {
          "name": "List all",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/resources",
              "host": ["{{base_url}}"],
              "path": ["resources"]
            }
          }
        },
        {
          "name": "Page 2",
          "request": {
            "method": "GET",
